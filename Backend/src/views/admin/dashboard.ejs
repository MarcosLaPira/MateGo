<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>MateGo - Dashboard</title>
  <link rel="stylesheet" href="/css/admin-dashboard.css" />
</head>
<body>

  <main class="contenedor">

    <header class="header-admin">

      <div class="logo">

        <img src="/png/te-de-mate.png" alt="" class="logoPng">
        <span class="titulo">MateGo - Dashboard</span>

      </div>
    

      <div class="acciones-header">

        <a href="/admin/productos/nuevo" class="btn">Agregar producto</a>

        <a href="http://127.0.0.1:5500/public/inicio/index.html" class="btn-secundario salir-btn">Salir</a>

      </div>

    </header>


      <% if (typeof error !== "undefined" && error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <table class="tabla-productos">

        <thead>

          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Activo</th>
            <th>Acciones</th>
          </tr>

        </thead>

        <tbody>

          <% productos.forEach(p => { %>

            <tr>

              <td><%= p.idProducto %></td>
              <td><%= p.nombre %></td>
              <td><%= p.descripcion %></td>
              <td>$<%= Number(p.precio).toFixed(2) %></td>
              <td><%= p.stock %></td>
              <td><%= p.activo ? "Sí" : "No" %></td>
              <td>

                <a href="/admin/productos/<%= p.idProducto %>/editar">Editar</a>

                <% if (p.activo) { %>

                  <form action="/admin/productos/<%= p.idProducto %>/eliminar" method="POST" style="display:inline;">

                    <button type="submit">Eliminar</button>

                  </form>

                <% } %>

              </td>

            </tr>

          <% }) %>
          
        </tbody>

      </table>

  </main>

   <footer class="pie">
    <small>MateGo - Proyecto UTN Programación III Lautaro Moreira y Marcos La Pira</small>
  </footer>


</body>
</html>
